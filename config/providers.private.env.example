# Example local-only ZEN provider configuration.
#
# The active file belongs outside Git at:
#   ZEN_HOME/secrets/providers.private.env
#
# This example intentionally uses a smaller local fallback than the historical
# 7B plan. Cloud multi-provider work belongs in providers.free_pool.env.example.
#
# A 3B-4B class Q4 model is the recommended local fallback tier for the known
# 4GB-VRAM / older-CPU machines. The exact GGUF/model id is operator-selected
# after the physical Worker returns; do not assume a specific runtime file exists.
# Optional per-slot REASONING_EFFORT accepts LOW, MEDIUM, HIGH, or MAX. Leave it
# blank when the provider does not support this request parameter.
#
ZEN_PROVIDER_MODE=PRIMARY_ONLY
ZEN_PROVIDER_SLOT_COUNT=3
ZEN_PROVIDER_PARALLELISM=1
ZEN_PROVIDER_PARALLEL_ROLES=

# Slot 1: lightweight local OpenAI-compatible server.
# Example family only; set MODEL to the exact id reported by your llama.cpp /
# Ollama-compatible server.
ZEN_PROVIDER_1_TYPE=OPENAI_COMPATIBLE_LOCAL
ZEN_PROVIDER_1_MODEL=Qwen3-4B-Q4_K_M
ZEN_PROVIDER_1_BASE_URL=http://127.0.0.1:8080/v1
ZEN_PROVIDER_1_API_KEY=
ZEN_PROVIDER_1_ROLES=
ZEN_PROVIDER_1_PRIORITY=100
ZEN_PROVIDER_1_COST_CLASS=LOCAL
ZEN_PROVIDER_1_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_1_TIMEOUT_SECONDS=120

# Unused slots stay blank.
ZEN_PROVIDER_2_TYPE=
ZEN_PROVIDER_2_MODEL=
ZEN_PROVIDER_2_BASE_URL=
ZEN_PROVIDER_2_API_KEY=
ZEN_PROVIDER_2_ROLES=
ZEN_PROVIDER_2_PRIORITY=100
ZEN_PROVIDER_2_COST_CLASS=UNKNOWN
ZEN_PROVIDER_2_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_2_TIMEOUT_SECONDS=45

ZEN_PROVIDER_3_TYPE=
ZEN_PROVIDER_3_MODEL=
ZEN_PROVIDER_3_BASE_URL=
ZEN_PROVIDER_3_API_KEY=
ZEN_PROVIDER_3_ROLES=
ZEN_PROVIDER_3_PRIORITY=100
ZEN_PROVIDER_3_COST_CLASS=UNKNOWN
ZEN_PROVIDER_3_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_3_TIMEOUT_SECONDS=45
