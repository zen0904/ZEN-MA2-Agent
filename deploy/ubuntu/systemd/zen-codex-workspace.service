[Unit]
Description=ZEN Mini visible Codex workspace
After=network-online.target zen-chatgpt-desktop.service zen-living-workspace.service
Wants=network-online.target zen-chatgpt-desktop.service

[Service]
Type=simple
User=zengw
Group=zengw
Environment=HOME=/home/zengw
Environment=USER=zengw
Environment=LOGNAME=zengw
Environment=DISPLAY=:0
Environment=TERM=xterm-256color
ExecStartPre=/bin/bash -lc 'for i in $(seq 1 40); do DISPLAY=:0 /usr/bin/xdpyinfo >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=/usr/bin/xterm -T "ZEN CX - GPT-5.6 Luna High" -name zen-codex-workspace -fa "DejaVu Sans Mono" -fs 9 -bg "#101316" -fg "#d9e6f2" -bd "#101316" -cr "#9fd3ff" -sb -rightbar -sl 5000 -e /usr/local/bin/codex --no-alt-screen -m gpt-5.6-luna -c model_reasoning_effort="high" -C /home/zengw/workspaces/zen-ma-ops-vnext-001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
