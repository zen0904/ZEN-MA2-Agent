[Unit]
Description=ZEN Sentinel lightweight host/show monitor
After=network-online.target zen-show-controller.service
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=zen-sentinel
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /usr/local/lib/zen-sentinel.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/zen-sentinel

[Install]
WantedBy=multi-user.target
