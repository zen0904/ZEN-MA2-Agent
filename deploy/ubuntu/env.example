# ZEN Linux/systemd deployment template.
# Copy to a host-specific EnvironmentFile outside Git.
ZEN_HOME=/var/lib/zen-ma2-agent
ZEN_NODE_ROLE=UNSELECTED
ZEN_NODE_ID=worker-a

# Field Core defaults remain loopback-only.
ZEN_OPERATOR_HOST=127.0.0.1
ZEN_OPERATOR_PORT=8876
ZEN_BRIDGE_HOST=127.0.0.1
ZEN_BRIDGE_PORT=8877

# Worker defaults remain loopback-only until private-network exposure is
# explicitly configured and the service command includes --allow-remote.
ZEN_WORKER_HOST=127.0.0.1
ZEN_WORKER_PORT=8878

# Do not commit secrets, API keys, MA credentials, or private-network tokens.
