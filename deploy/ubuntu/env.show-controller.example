# ZEN Show Agent Controller host example.
# Host-specific values belong outside Git; do not commit secrets.
ZEN_HOME=/var/lib/zen-ma2-agent
ZEN_NODE_ROLE=SHOW_AGENT_CONTROLLER
ZEN_NODE_ID=zen-agent-server

# Keep control-plane endpoints loopback-only by default.
ZEN_OPERATOR_HOST=127.0.0.1
ZEN_OPERATOR_PORT=8876
ZEN_BRIDGE_HOST=127.0.0.1
ZEN_BRIDGE_PORT=8877

# The Lighting department adapter is reached through the Mini loopback typed
# proxy. That proxy crosses Tailscale to the Windows Preview-only facade; do not
# point the Controller directly at the Windows full Operator API.
ZEN_LIGHTING_ADAPTER_URL=http://127.0.0.1:18878

# Worker service remains separate and is not enabled by this profile.
ZEN_WORKER_HOST=127.0.0.1
ZEN_WORKER_PORT=8878
