# Example USB-local provider configuration for a CPU-only host
# (e.g. 2014 MacBook Pro under Bootcamp: i7-4770HQ, 16GB RAM, no discrete GPU).
#
# This file is committed as documentation only. The real, active file lives at
# ZEN_HOME\secrets\providers.private.env (or config/providers.private.env when
# not using the portable launcher) and is Git-ignored -- never commit that one.
#
# Setup on this machine:
#   1. Download llama.cpp (prebuilt Windows release is fine on this hardware,
#      no CUDA/GPU build needed) from https://github.com/ggml-org/llama.cpp
#   2. Download a Q4_K_M GGUF build of a 7B-8B instruct model, e.g.
#      Qwen2.5-7B-Instruct-Q4_K_M.gguf (~4.5-5GB). Put it under
#      ZEN_HOME\models\ (portable_state_path("models")).
#   3. Run the server, using all physical+logical threads on the 4770HQ
#      (4 cores / 8 threads):
#        llama-server.exe -m ZEN_HOME\models\Qwen2.5-7B-Instruct-Q4_K_M.gguf ^
#          --port 8080 -t 8 -c 8192
#   4. Copy this file to ZEN_HOME\secrets\providers.private.env and adjust
#      ZEN_PROVIDER_1_MODEL to match the exact GGUF filename you downloaded.
#
# ZEN_PROVIDER_MODE:
#   PRIMARY_ONLY -- always use slot 1 only (recommended for a single local model).
#   FALLBACK     -- try slot 1, then slot 2, then slot 3 in order.
#   ROUTED       -- pick by declared ROLES first, then any general-purpose slot.
ZEN_PROVIDER_MODE=PRIMARY_ONLY

# Slot 1: the local, key-free llama.cpp server. OPENAI_COMPATIBLE_LOCAL does
# not require ZEN_PROVIDER_1_API_KEY to be set -- leave it blank.
ZEN_PROVIDER_1_TYPE=OPENAI_COMPATIBLE_LOCAL
ZEN_PROVIDER_1_MODEL=Qwen2.5-7B-Instruct-Q4_K_M
ZEN_PROVIDER_1_BASE_URL=http://127.0.0.1:8080/v1
ZEN_PROVIDER_1_API_KEY=
# Leave ROLES empty to accept every role (DESIGNER, RESEARCHER, CRITIC, ...);
# on a single-model CPU host there is only one slot to route to anyway.
ZEN_PROVIDER_1_ROLES=
# CPU-only 7B inference on this hardware can take a while per role; keep this
# generous rather than timing out a slow-but-working response.
ZEN_PROVIDER_1_TIMEOUT_SECONDS=180

# Slots 2 and 3 are unused on this machine. Leave them blank rather than
# deleting the keys -- load_provider_slots() expects all three slots present.
ZEN_PROVIDER_2_TYPE=
ZEN_PROVIDER_2_MODEL=
ZEN_PROVIDER_2_BASE_URL=
ZEN_PROVIDER_2_API_KEY=

ZEN_PROVIDER_3_TYPE=
ZEN_PROVIDER_3_MODEL=
ZEN_PROVIDER_3_BASE_URL=
ZEN_PROVIDER_3_API_KEY=
