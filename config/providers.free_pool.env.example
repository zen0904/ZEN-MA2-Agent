# ZEN multi-provider free-first pool example.
#
# Copy to:
#   ZEN_HOME/secrets/providers.private.env
#
# API keys stay outside Git.
#
# IMPORTANT:
# - COST_CLASS is operator-declared routing metadata, not a permanent billing
#   truth. Free tiers and model availability change. Verify each account before
#   marking a slot FREE.
# - FREE_FIRST routes FREE slots first, then LOCAL, then UNKNOWN, then PAID.
# - Provider failures / quota responses naturally fall through on normal calls.
# - LIGHTING_DESIGNER and CRITIC are configured for two-provider parallel
#   candidate generation. Researcher and Finalizer remain single canonical
#   calls because the pipeline has real dependencies between stages.
# - Local 3B-4B class inference is degraded/offline fallback, not the primary
#   artistic brain.
# - Optional per-slot REASONING_EFFORT accepts LOW, MEDIUM, HIGH, or MAX; blank
#   omits the request parameter.
#
ZEN_PROVIDER_MODE=FREE_FIRST
ZEN_PROVIDER_SLOT_COUNT=8
ZEN_PROVIDER_PARALLELISM=2
ZEN_PROVIDER_PARALLEL_ROLES=LIGHTING_DESIGNER,CRITIC

# 1 — Google Gemini. Official OpenAI-compatible endpoint.
# Verify the model remains on your project's Free Tier before COST_CLASS=FREE.
ZEN_PROVIDER_1_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_1_MODEL=gemini-3.8-flash
ZEN_PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ZEN_PROVIDER_1_API_KEY=
ZEN_PROVIDER_1_ROLES=LIGHTING_DESIGNER,FINALIZER
ZEN_PROVIDER_1_PRIORITY=10
ZEN_PROVIDER_1_COST_CLASS=FREE
ZEN_PROVIDER_1_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_1_TIMEOUT_SECONDS=90

# 2 — Groq. Keep the exact model id aligned with the account's current model list.
ZEN_PROVIDER_2_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_2_MODEL=openai/gpt-oss-120b
ZEN_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
ZEN_PROVIDER_2_API_KEY=
ZEN_PROVIDER_2_ROLES=RESEARCHER,CRITIC
ZEN_PROVIDER_2_PRIORITY=10
ZEN_PROVIDER_2_COST_CLASS=FREE
ZEN_PROVIDER_2_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_2_TIMEOUT_SECONDS=60

# 3 — NVIDIA hosted NIM / Build free endpoint.
# GLM-5.3-Flash is a current example; replace it when NVIDIA rotates endpoints.
ZEN_PROVIDER_3_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_3_MODEL=z-ai/glm-5-3-flash
ZEN_PROVIDER_3_BASE_URL=https://integrate.api.nvidia.com/v1
ZEN_PROVIDER_3_API_KEY=
ZEN_PROVIDER_3_ROLES=LIGHTING_DESIGNER,CRITIC
ZEN_PROVIDER_3_PRIORITY=20
ZEN_PROVIDER_3_COST_CLASS=FREE
ZEN_PROVIDER_3_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_3_TIMEOUT_SECONDS=90
ZEN_PROVIDER_3_REASONING_EFFORT=

# 4 — Mistral/OpenAI-compatible slot.
# Leave MODEL blank until the account's current free-access model is verified.
ZEN_PROVIDER_4_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_4_MODEL=
ZEN_PROVIDER_4_BASE_URL=https://api.mistral.ai/v1
ZEN_PROVIDER_4_API_KEY=
ZEN_PROVIDER_4_ROLES=RESEARCHER,FINALIZER
ZEN_PROVIDER_4_PRIORITY=20
ZEN_PROVIDER_4_COST_CLASS=FREE
ZEN_PROVIDER_4_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_4_TIMEOUT_SECONDS=90

# 5 — OpenRouter free pool. Model/provider may vary, so this is lower priority
# than named model families.
ZEN_PROVIDER_5_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_5_MODEL=openrouter/free
ZEN_PROVIDER_5_BASE_URL=https://openrouter.ai/api/v1
ZEN_PROVIDER_5_API_KEY=
ZEN_PROVIDER_5_ROLES=RESEARCHER,LIGHTING_DESIGNER,CRITIC,FINALIZER
ZEN_PROVIDER_5_PRIORITY=60
ZEN_PROVIDER_5_COST_CLASS=FREE
ZEN_PROVIDER_5_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_5_TIMEOUT_SECONDS=90

# 6 — Cerebras-compatible slot. Fill the current free-tier model after account
# verification instead of hard-coding a stale model id.
ZEN_PROVIDER_6_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_6_MODEL=
ZEN_PROVIDER_6_BASE_URL=https://api.cerebras.ai/v1
ZEN_PROVIDER_6_API_KEY=
ZEN_PROVIDER_6_ROLES=RESEARCHER,CRITIC
ZEN_PROVIDER_6_PRIORITY=30
ZEN_PROVIDER_6_COST_CLASS=FREE
ZEN_PROVIDER_6_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_6_TIMEOUT_SECONDS=60

# 7 — Reserved for another OpenAI-compatible free endpoint such as a
# Cloudflare account-specific compatibility URL. Blank = disabled.
ZEN_PROVIDER_7_TYPE=OPENAI_COMPATIBLE
ZEN_PROVIDER_7_MODEL=
ZEN_PROVIDER_7_BASE_URL=
ZEN_PROVIDER_7_API_KEY=
ZEN_PROVIDER_7_ROLES=
ZEN_PROVIDER_7_PRIORITY=80
ZEN_PROVIDER_7_COST_CLASS=FREE
ZEN_PROVIDER_7_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_7_TIMEOUT_SECONDS=90

# 8 — lightweight local fallback.
ZEN_PROVIDER_8_TYPE=OPENAI_COMPATIBLE_LOCAL
ZEN_PROVIDER_8_MODEL=Qwen3-4B-Q4_K_M
ZEN_PROVIDER_8_BASE_URL=http://127.0.0.1:8080/v1
ZEN_PROVIDER_8_API_KEY=
ZEN_PROVIDER_8_ROLES=
ZEN_PROVIDER_8_PRIORITY=999
ZEN_PROVIDER_8_COST_CLASS=LOCAL
ZEN_PROVIDER_8_RESPONSE_FORMAT=JSON_OBJECT
ZEN_PROVIDER_8_TIMEOUT_SECONDS=120
