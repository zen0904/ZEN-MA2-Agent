[Unit]
Description=ZEN Ops Tailscale Funnel recovery
After=network-online.target tailscaled.service zen-ops-results.service
Wants=network-online.target
Requires=tailscaled.service zen-ops-results.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/curl -fsS --retry 20 --retry-delay 1 --max-time 5 http://127.0.0.1:18991/
ExecStart=/usr/bin/tailscale funnel --yes --bg --https=10000 http://127.0.0.1:18991
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
